pipeline {
    agent any
    stages {
        stage('Clone') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'docker build -t webapp .'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker run -d -p 8070:80 webapp'
            }
        }
    }
}
