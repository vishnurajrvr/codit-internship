pipeline {
    agent any

    environment {
        GIT_CREDENTIALS = 'de66972a-8845-4d9e-be98-39df0e181559' // Your GitHub credential ID
    }

    stages {
        stage('Clone') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/app']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/vishnurajrvr/codit-internship.git',
                        credentialsId: "${GIT_CREDENTIALS}"
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                bat '''
                echo Building the project...
                dir
                '''
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                echo Deploying the project...
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
