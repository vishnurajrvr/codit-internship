pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building the project...'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                docker build -t coditvishnu .
                docker run -d -p 8070:80 --name coditvishnu_container coditvishnu
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
